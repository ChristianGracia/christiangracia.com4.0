{
  "name": "christiangracia-ssr",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "dev": "ng s --configuration=dev",
    "prerender": "ng run christiangracia-ssr:prerender",
    "heroku-postbuild": "npm run clean-build",
    "build:stats": "ng build --stats-json",
    "analyze": "webpack-bundle-analyzer dist/browser/stats.json",
    "clean-build": "rm -rf dist/ && npm run build:ssr",
    "stats": "npm run build:stats && npm run analyze",
    "lint": "ng lint",
    "compile:server": "webpack --config webpack.server.config.js --progress --colors",
    "serve:ssr": "node dist/server",
    "format": "prettier --write .",
    "build:ssr:prod": "npm run build:client-and-server-bundles:prod && npm run compile:server",
    "build:ssr:cert": "npm run build:client-and-server-bundles:cert && npm run compile:server",
    "build:ssr:dev": "npm run build:client-and-server-bundles:dev && npm run compile:server",
    "build:client-and-server-bundles:prod": "ng build --configuration=prod-ssr && ng run christiangracia-ssr:server:prod-ssr --bundleDependencies all",
    "build:client-and-server-bundles:cert": "ng build --configuration=cert-ssr && ng run christiangracia-ssr:server:cert-ssr --bundleDependencies all",
    "build:client-and-server-bundles:dev": "ng build --configuration=dev-ssr && ng run christiangracia-ssr:server:dev-ssr --bundleDependencies all",
    "push-p": "heroku container:push web --app christiangracia",
    "release-p": "heroku container:release web --app christiangracia",
    "push-s": "heroku container:push web --app christiangracia-staging",
    "release-s": "heroku container:release web --app christiangracia-staging",
    "rebuild": "docker-compose down && docker-compose build && docker-compose up",
    "docker-login": "heroku authorizations:create",
    "login": "heroku container:login",
    "deploy": "npm run push-p && npm run release-p"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.12",
    "@angular/cdk": "^12.2.6",
    "@angular/common": "^16.2.12",
    "@angular/compiler": "^16.2.12",
    "@angular/core": "^16.2.12",
    "@angular/forms": "^16.2.12",
    "@angular/material": "^12.2.6",
    "@angular/platform-browser": "^16.2.12",
    "@angular/platform-browser-dynamic": "^16.2.12",
    "@angular/platform-server": "^16.2.12",
    "@angular/router": "^16.2.12",
    "@ngbmodule/material-carousel": "^0.7.2",
    "@nguniversal/express-engine": "^12.1.0",
    "express": "^4.15.2",
    "rxjs": "~6.6.0",
    "zone.js": "~0.13.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.7",
    "@angular/cli": "^20.3.7",
    "@angular/compiler-cli": "^16.2.12",
    "@nguniversal/builders": "^16.2.0",
    "@types/angular": "^1.8.4",
    "@types/express": "^4.17.0",
    "@types/jasmine": "~3.8.0",
    "@types/node": "^12.11.1",
    "css-minimizer-webpack-plugin": "^4.0.0",
    "jasmine-core": "~3.8.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "prettier": "^2.5.1",
    "terser-webpack-plugin": "^5.3.1",
    "ts-lib": "^0.0.5",
    "ts-loader": "^9.2.6",
    "tslib": "^2.4.0",
    "typescript": "~4.9.5",
    "webpack-bundle-analyzer": "^4.4.2",
    "webpack-cli": "^3.1.0"
  }
}